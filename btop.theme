# btop theme from your Neovim palette (light/blue)

# Main UI
theme[main_bg]="#ffffff"         # base00
theme[main_fg]="#3b83bd"         # base05
theme[title]="#0a64f5"           # base04/base09
theme[hi_fg]="#0a64f5"           # base04/base09
theme[selected_bg]="#77dde7"     # base02
theme[selected_fg]="#030303"     # base06
theme[inactive_fg]="#afdafc"     # base03
theme[graph_text]="#151719"      # base0C
theme[meter_bg]="#f8f8ff"        # base07
theme[proc_misc]="#6495ed"       # base0A

# CPU
theme[cpu_box]="#3b83bd"         # base0D
theme[cpu_core]="#0a64f5"        # base0B
theme[cpu_temp]="#b87333"        # base0F
theme[cpu_low]="#77dde7"         # base02
theme[cpu_medium]="#6495ed"      # base0A
theme[cpu_high]="#1560bd"        # base08

# Memory / Swap
theme[mem_box]="#3b83bd"         # base0D
theme[mem]="#0a64f5"             # base0B
theme[swap]="#0047ab"            # base0E

# Network
theme[net_box]="#3b83bd"         # base0D
theme[net_download]="#0a64f5"    # base0B
theme[net_upload]="#1560bd"      # base08

# Processes / Boxes
theme[proc_box]="#3b83bd"        # base0D
theme[proc_high]="#1560bd"       # base08
theme[proc_medium]="#0047ab"     # base0E
theme[proc_low]="#6495ed"        # base0A
theme[proc_name]="#0a64f5"       # base04/base09

# Borders and dividers
theme[div_line]="#afdafc"        # base03
theme[box_bg]="#ffffff"          # base00
theme[box_fg]="#151719"          # base0C

# Cursor / selection
theme[cursor]="#151719"          # base0C

# ANSI colors 0-15 (match your Alacritty mapping)
theme[color0]="#afdafc"          # normal black
theme[color1]="#1560bd"          # normal red
theme[color2]="#0a64f5"          # normal green
theme[color3]="#6495ed"          # normal yellow
theme[color4]="#3b83bd"          # normal blue
theme[color5]="#0047ab"          # normal magenta
theme[color6]="#151719"          # normal cyan
theme[color7]="#030303"          # normal white
theme[color8]="#afdafc"          # bright black
theme[color9]="#1560bd"          # bright red
theme[color10]="#0a64f5"         # bright green
theme[color11]="#6495ed"         # bright yellow
theme[color12]="#0a64f5"         # bright blue
theme[color13]="#0047ab"         # bright magenta
theme[color14]="#151719"         # bright cyan
theme[color15]="#f8f8ff"         # bright white