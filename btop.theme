# White Air theme for btop (Omarchy 4.0.0)

# Main UI
theme[main_bg]="#ffffff"
theme[main_fg]="#1e293b"
theme[title]="#0a64f5"
theme[hi_fg]="#0a64f5"
theme[selected_bg]="#cbd5e1"
theme[selected_fg]="#0f172a"
theme[inactive_fg]="#94a3b8"
theme[graph_text]="#64748b"
theme[meter_bg]="#f1f5f9"
theme[proc_misc]="#7c3aed"

# CPU
theme[cpu_box]="#0a64f5"
theme[cpu_core]="#0a64f5"
theme[cpu_temp]="#ea580c"
theme[cpu_low]="#059669"
theme[cpu_medium]="#d97706"
theme[cpu_high]="#e11d48"

# Memory / Swap
theme[mem_box]="#0a64f5"
theme[mem]="#059669"
theme[swap]="#7c3aed"

# Network
theme[net_box]="#0a64f5"
theme[net_download]="#059669"
theme[net_upload]="#e11d48"

# Processes / Boxes
theme[proc_box]="#0a64f5"
theme[proc_high]="#e11d48"
theme[proc_medium]="#7c3aed"
theme[proc_low]="#059669"
theme[proc_name]="#0a64f5"

# Borders and dividers
theme[div_line]="#cbd5e1"
theme[box_bg]="#ffffff"
theme[box_fg]="#1e293b"

# Cursor / selection
theme[cursor]="#0a64f5"

# ANSI colors 0-15
theme[color0]="#f1f5f9"
theme[color1]="#e11d48"
theme[color2]="#059669"
theme[color3]="#d97706"
theme[color4]="#0a64f5"
theme[color5]="#7c3aed"
theme[color6]="#0284c7"
theme[color7]="#1e293b"
theme[color8]="#94a3b8"
theme[color9]="#f43f5e"
theme[color10]="#10b981"
theme[color11]="#f59e0b"
theme[color12]="#2563eb"
theme[color13]="#8b5cf6"
theme[color14]="#06b6d4"
theme[color15]="#0f172a"