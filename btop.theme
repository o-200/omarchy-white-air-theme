# btop theme generated from provided color schema

# Main UI
theme[main_bg]="#ffffff"
theme[main_fg]="#121212"
theme[title]="#0a64f5"
theme[hi_fg]="#0a64f5"
theme[selected_bg]="#0a64f5"
theme[selected_fg]="#ffffff"
theme[inactive_fg]="#45475a"
theme[graph_text]="#121212"
theme[meter_bg]="#ffffff"
theme[proc_misc]="#5796cc"

# CPU
theme[cpu_box]="#0a64f5"
theme[cpu_core]="#45c43b"
theme[cpu_temp]="#eda912"
theme[cpu_low]="#318c2a"
theme[cpu_medium]="#edc612"
theme[cpu_high]="#ff000a"

# Memory / Swap
theme[mem_box]="#0a64f5"
theme[mem]="#008aff"
theme[swap]="#5796cc"

# Network
theme[net_box]="#0a64f5"
theme[net_download]="#45c43b"
theme[net_upload]="#e71852"

# Processes / Boxes
theme[proc_box]="#0a64f5"
theme[proc_high]="#e71852"
theme[proc_medium]="#eda912"
theme[proc_low]="#5796cc"
theme[proc_name]="#5796cc"

# Borders and dividers
theme[div_line]="#5796cc"
theme[box_bg]="#ffffff"
theme[box_fg]="#121212"

# Cursor / selection
theme[cursor]="#121212"

# ANSI colors 0-15
theme[color0]="#ffffff"
theme[color1]="#e71852"
